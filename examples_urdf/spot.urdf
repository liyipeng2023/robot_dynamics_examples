        <mesh filename="link_models/fl.hip.obj"/>
      </geometry>
      <material name="fl.hip"> <color rgba="0.2 0.2 0.2 1"/></material>
    </visual>
  </link>

  <joint name="fl.hx" type="revolute">
    <origin xyz="0.29785 0.05500 0.00000" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <parent link="base"/>
    <child link="fl.hip"/>
    <limit effort="1000" velocity="1000.00" lower="-0.785398" upper="0.785398"/>
