<?xml version="1.0" ?>
<robot name="spot">

  <!-- =================================================== -->
  <!--                      BASE LINK                      -->
  <!-- =================================================== -->
  <link name="base">
    <inertial>
      <origin xyz="0.008 0.000 -0.001" rpy="0 0 0"/>
      <mass value="32.86"/>
      <inertia ixx="0.131" ixy="0.000" ixz="0.002" iyy="0.439" iyz="0.000" izz="0.457"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="link_models/base.obj"/>
      </geometry>
      <material name="base"> <color rgba="1 0.8431 0 1"/></material>
    </visual>
  </link>

  <!-- =================================================== -->
  <!--                 FRONT LEFT LEG (FL)                 -->
  <!-- =================================================== -->
  <link name="fl.hip">
    <inertial>
      <origin xyz="-0.005 0.000 -0.001" rpy="0 0 0"/>
      <mass value="1.68"/>
